    {
      "name": "1. Error 400 - Bad Request",
      "item": [
        {
          "name": "Body vacío al crear servicio -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/servicios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', () => pm.response.to.have.status(400));",
                  "pm.test('Formato de error estándar', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.have.all.keys('estado','mensaje','errores','ruta','fecha');",
                  "  pm.expect(j.estado).to.eql(400);",
                  "});",
                  "pm.test('No expone información interna', () => {",
                  "  pm.expect(pm.response.text()).to.not.match(/stack|ECONNREFUSED|secreto123|node_modules/);",
                  "});"
                ]
              }
            }
          ]
        },
