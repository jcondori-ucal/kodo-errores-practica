      "name": "0. Control (casos felices)",
      "item": [
        {
          "name": "Listar servicios -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servicios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicios"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));"
